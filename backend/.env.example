# ArenaVerse Backend Environment Configuration Example
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/arena_verse
JWT_SECRET=your_dev_jwt_secret_key_change_in_production
FRONTEND_URL=http://localhost:5173

# Third-Party API Keys (Development Stubs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-email@gmail.com

# 2FA Configuration
TWO_FACTOR_OTP_EXPIRY_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN_SECONDS=60
